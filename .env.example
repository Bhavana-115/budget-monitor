# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/budget_monitoring
# For MongoDB Atlas, use something like:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/budget_monitoring

# JWT Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:4200

# Monitoring thresholds (defaults, also configurable via Admin API)
UNDER_UTILIZATION_THRESHOLD=40
TIME_ELAPSED_THRESHOLD=70
SPIKE_MULTIPLIER=3
